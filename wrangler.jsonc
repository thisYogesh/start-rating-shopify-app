{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "star-rating",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./build/client"
  },

  // Non-secret env vars (set real values after first deploy)
  "vars": {
    "SCOPES": "write_products"
  },

  // D1 — rating data
  // Create with: npx wrangler d1 create star-rating-db
  // Then paste the database_id below
  "d1_databases": [
    {
      "binding": "STAR_RATING_DB",
      "database_name": "star-rating-db",
      "database_id": "a814ac64-a5d3-4cb9-9965-234968dfadd7",
      "migrations_dir": "migrations"
    }
  ],

  // KV — session storage
  // Create with: npx wrangler kv namespace create SESSION_STORAGE
  // Then paste the id below
  "kv_namespaces": [
    {
      "binding": "SESSION_STORAGE",
      "id": "d8af390ff2da40d090d8d59a9cb15526"
    }
  ]
}
