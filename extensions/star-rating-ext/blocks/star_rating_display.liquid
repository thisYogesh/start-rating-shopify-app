{% assign star_color = block.settings.star_color %}
{% assign text_color = block.settings.text_color %}
{% assign show_count = block.settings.show_count %}
{% assign star_size = block.settings.star_size %}

{% comment %} Use the manually picked product if set, otherwise fall back to the contextual product object {% endcomment %}
{% if block.settings.product != blank %}
  {% assign rating_product = block.settings.product %}
{% else %}
  {% assign rating_product = product %}
{% endif %}

{% assign avg = rating_product.metafields.star_rating.avg_rating.value | plus: 0.0 %}
{% assign count = rating_product.metafields.star_rating.rating_count.value | plus: 0 %}
{% assign avg_rounded = avg | round: 1 %}
{% comment %} Compute fill percentage per star (0–100) for precise partial fills {% endcomment %}

<div class="sr-display" style="--sr-color: {{ star_color }}; --sr-empty: #d4d4d8; --sr-text: {{ text_color }}; --sr-size: {{ star_size }}px;" role="img" aria-label="{{ avg_rounded }} out of 5 stars based on {{ count }} {{ count | pluralize: 'rating', 'ratings' }}">
  <div class="sr-display__stars">
    {%- for i in (1..5) -%}
      {%- assign fill = avg | minus: i | plus: 1 -%}
      {%- if fill >= 1 -%}
        {%- assign pct = 100 -%}
      {%- elsif fill > 0 -%}
        {%- assign pct = fill | times: 100 | round: 0 -%}
      {%- else -%}
        {%- assign pct = 0 -%}
      {%- endif -%}
      <svg class="sr-star" viewBox="0 0 24 24" width="var(--sr-size, 20)" height="var(--sr-size, 20)" aria-hidden="true">
        <defs>
          <linearGradient id="sr-grad-{{ block.id }}-{{ i }}">
            <stop offset="{{ pct }}%" stop-color="var(--sr-color, #FFD700)" />
            <stop offset="{{ pct }}%" stop-color="var(--sr-empty, #d4d4d8)" />
          </linearGradient>
        </defs>
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01L12 2z"
              fill="url(#sr-grad-{{ block.id }}-{{ i }})"
              stroke="none" />
      </svg>
    {%- endfor -%}
  </div>

  {% if show_count %}
    <div class="sr-display__meta">
      {% if avg > 0 %}
        <span class="sr-display__score">{{ avg_rounded }}</span>
        <span class="sr-display__sep">&middot;</span>
        <span class="sr-display__count">{{ count }} {{ count | pluralize: 'review', 'reviews' }}</span>
      {% else %}
        <span class="sr-display__count sr-display__count--empty">No reviews yet</span>
      {% endif %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Star Rating Display",
  "target": "section",
  "stylesheet": "star-rating.css",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#FFD700"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show rating count",
      "default": true
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star Size (px)",
      "min": 12,
      "max": 32,
      "step": 1,
      "default": 20
    }
  ]
}
{% endschema %}
